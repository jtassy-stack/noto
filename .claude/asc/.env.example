# asc-kit — local ASC credentials. Copy to .claude/asc/.env (gitignored).
#
# One App Store Connect API key per team is enough (role: App Manager).
# The SAME variable names are used by CI (as GitHub secrets), fastlane and
# the testflight-feedback plugin — never invent a local variant.
#
# CI equivalents (gh secret set …):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_BASE64 (base64 of the .p8),
#   APPLE_CERTIFICATE_BASE64, APPLE_CERTIFICATE_PASSWORD,
#   PROVISIONING_PROFILE_* (base64, one per profile in config.json)

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
