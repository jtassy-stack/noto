#!/bin/sh
# Blocks commits that contain secrets. Enable once per clone:
#   git config core.hooksPath .githooks
# Install gitleaks: brew install gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks) — skipping secret scan" >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --config "$(git rev-parse --show-toplevel)/.gitleaks.toml" --redact
