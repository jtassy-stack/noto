// Committed base configuration. Keys default to empty so a fresh clone
// builds; the clients log a warning and fall back when a key is missing.
// Real values come from Config.xcconfig (gitignored, see
// Config.example.xcconfig), written by CI from GitHub secrets.
DIRECTORY_API_KEY =
CULTURE_API_KEY =

// Family sync (CloudKit, phase 9). Stays NO until the iCloud container
// iCloud.fr.noto.app exists and the app carries the iCloud entitlement:
// CKContainer(identifier:) traps without it.
FAMILY_SYNC_ENABLED = NO

#include? "Config.xcconfig"
