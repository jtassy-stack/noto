// Copy to Config.xcconfig (gitignored) and fill in. Read by project.yml
// (configFiles) → Info.plist (DirectoryAPIKey, CultureAPIKey) → API clients.
// CI writes the same file from the DIRECTORY_API_KEY / CULTURE_API_KEY secrets.
DIRECTORY_API_KEY = your_celyn_directory_key
CULTURE_API_KEY = your_celyn_culture_key
